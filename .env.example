# ─── Tier 1: Local Claude Proxy & Ollama ────────────────────────────────
LLM_PROVIDER=claude_free
LOCAL_CLAUDE_URL=http://127.0.0.1:3000/api
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# ─── Tier 2: Gemini API Keys (add up to 4 for rate-limit rotation) ───
# Get free keys at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# ─── Tier 3: OpenRouter Keys (last-resort fallback) ─────────────────
# Get keys at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=

# ─── Direct Email Dispatch (Optional — No Firebase Required) ───────────
# If provided, KAIRO emails recruiters directly via SMTP/Nodemailer.
# If omitted, KAIRO uses Playwright Browser Webmail (Gmail/Outlook) with human handoff.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Your Name <your.email@gmail.com>"

# ─── Optional: OmniRoute LLM Gateway (off by default) ─────────────────
# OmniRoute (github.com/diegosouzapw/OmniRoute) is a local AI gateway
# that routes LLM requests across multiple providers with auto-fallback.
# When enabled, it acts as Tier 0 (tried before Groq/Gemini/OpenRouter).
# See scripts/omniroute_setup.md for installation instructions.
OMNIROUTE_ENABLED=false
OMNIROUTE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto/fast
OMNIROUTE_ALLOW_REMOTE=false

# ─── Optional: SerpApi Live Search Engine ──────────────────────────────
# HireScout queries Google Jobs via SerpApi.
# If omitted, HireScout automatically uses a realistic mock job pool.
SERPAPI_KEY=your_serpapi_key_here

# ─── Application & Browser Flow Settings ──────────────────────────────
# APPLY_TARGET mode:
#   auto = Real-first apply; falls back to local demo_site/apply.html if all blocked (default)
#   real = Real application pages only; no demo fallback
#   demo = Force local demo_site/apply.html for rehearsals
APPLY_TARGET=auto
BROWSER_HEADLESS=false
BROWSER_SPEED=50

